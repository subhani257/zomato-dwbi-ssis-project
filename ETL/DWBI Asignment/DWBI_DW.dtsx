            <component
              refId="Package\DFT_Load_Fact\Extract data from Staging Tables"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Extract data from Staging Tables"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    s.[session_id],
    s.[user_id],            -- Required for Dim_User Lookup
    s.[restaurant_id],      -- Required for Dim_Restaurant Lookup
    s.[session_timestamp],   -- Required for Dim_Date Lookup
    c.[base_cart_item_count],
    c.[base_cart_value],
    c.[cart_completion_score],
    o.[actual_added_addon_count],
    o.[actual_added_addon_value],
    o.[any_addon_added],
    o.[final_order_value],
    s.[estimated_delivery_time],
    s.[session_engagement_score],
    r.[avg_reco_score],
    r.[avg_reco_price_ratio],
    r.[avg_reco_popularity],
    -- MATCHING ATTRIBUTES FOR REMAINING LOOKUPS --
    s.[weather_condition],   -- For Dim_Environment Lookup
    s.[traffic_density],     -- For Dim_Environment Lookup
    s.[is_festival_day],     -- For Dim_Environment Lookup
    c.[cart_has_drink],      -- For Dim_Cart Lookup
    c.[cart_has_dessert],    -- For Dim_Cart Lookup
    c.[cart_has_side],       -- For Dim_Cart Lookup
    r.[recommended_addon_categories], -- For Dim_Addon Lookup
    r.[avg_reco_is_complementary]     -- For Dim_Addon Lookup
FROM [dbo].[StgSessions] s
JOIN [dbo].[StgCart] c ON s.[session_id] = c.[session_id]
JOIN [dbo].[StgOrder] o ON s.[session_id] = o.[session_id]
JOIN [dbo].[StgRecommendations] r ON s.[session_id] = r.[session_id]</property>
