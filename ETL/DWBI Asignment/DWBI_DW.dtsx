                          name="Expression">[DATEPART]("dw",(DT_DBDATE)#{Package\DFT_Load_Dim_Date\Sort for Sessions.Outputs[Sort Output].Columns[full_date_clean]}) == 1 ? "Sunday" : [DATEPART]("dw",(DT_DBDATE)#{Package\DFT_Load_Dim_Date\Sort for Sessions.Outputs[Sort Output].Columns[full_date_clean]}) == 2 ? "Monday" : [DATEPART]("dw",(DT_DBDATE)#{Package\DFT_Load_Dim_Date\Sort for Sessions.Outputs[Sort Output].Columns[full_date_clean]}) == 3 ? "Tuesday" : [DATEPART]("dw",(DT_DBDATE)#{Package\DFT_Load_Dim_Date\Sort for Sessions.Outputs[Sort Output].Columns[full_date_clean]}) == 4 ? "Wednesday" : [DATEPART]("dw",(DT_DBDATE)#{Package\DFT_Load_Dim_Date\Sort for Sessions.Outputs[Sort Output].Columns[full_date_clean]}) == 5 ? "Thursday" : [DATEPART]("dw",(DT_DBDATE)#{Package\DFT_Load_Dim_Date\Sort for Sessions.Outputs[Sort Output].Columns[full_date_clean]}) == 6 ? "Friday" : "Saturday"</property>
